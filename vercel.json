{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "functions": {
    "api/weather.js": {
      "maxDuration": 10
    },
    "api/mandi.js": {
      "maxDuration": 15
    }
  },
  "headers": [
    {
      "source": "/api/(.*)",
      "headers": [
        { "key": "Cache-Control", "value": "public, s-maxage=900, stale-while-revalidate=1800" },
        { "key": "X-Content-Type-Options", "value": "nosniff" }
      ]
    }
  ]
}
